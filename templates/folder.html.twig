{#
 # One folder tile in the overview grid. Included in a loop from
 # layout.html.twig with r = {room, links, color, preview}.
 #}
<a class="folder" href="#{{ r.room.id }}"
   aria-label="Open the {{ r.room.name }} folder — {{ r.room.topic }}">
    <span class="folder-icon" style="--room-color: {{ r.color }}" aria-hidden="true">
        {% if r.preview.small is null %}
            {% for tile in r.preview.large %}
                <span class="folder-slot{{ tile is null ? ' folder-slot-empty' : '' }}">{{ include('_tile-visual.html.twig', {tile: tile}, false) }}</span>
            {% endfor %}
        {% else %}
            {% for tile in r.preview.large %}
                <span class="folder-slot">{{ include('_tile-visual.html.twig', {tile: tile}, false) }}</span>
            {% endfor %}
            <span class="folder-slot folder-slot-group">
                {% for tile in r.preview.small %}
                    <span class="folder-slot-mini{{ tile is null ? ' folder-slot-mini-empty' : '' }}">{{ include('_tile-visual.html.twig', {tile: tile}, false) }}</span>
                {% endfor %}
            </span>
        {% endif %}
    </span>
    <span class="folder-topic">{{ r.room.topic }}</span>
</a>
