{#
 # The full link list of one room: reachable without JavaScript as a plain
 # section below the chart. With JavaScript the section is hidden and
 # public/js/sunny.js copies .room-section-inner into the sheet (phone) or
 # panel (desktop).
 #}
{% set roomId = r.room.id %}
{% set headingId = roomId ~ '-heading' %}
<section id="{{ roomId }}" class="room-section" style="--room-color: {{ r.color }}" aria-labelledby="{{ headingId }}" data-room="{{ roomId }}" data-number="{{ r.number }}" data-topic="{{ r.room.topic }}" data-count="{{ r.linkCount == 1 ? '1 link' : r.linkCount ~ ' links' }}" data-sub="{{ r.room.name }} · {{ r.room.character }}">
    <div class="room-section-inner">
        <a class="back-link" href="./">&larr; Back to the chart</a>
        <h2 id="{{ headingId }}">{{ r.room.name }} <span class="room-character">· {{ r.room.character }}</span></h2>
        <p class="room-description">{{ r.room.description }}</p>
        {% if r.links is empty %}
            <p class="room-empty">No links here yet.</p>
        {% else %}
            <ul class="link-list">
                {% for link in r.links %}
                    {% set isAddTile = link.is_add_shop|default(false) or link.is_suggestion|default(false) %}
                    <li class="link-tile{{ isAddTile ? ' link-tile-add' : '' }}">
                        <a href="{{ link.url }}" target="_blank" rel="noopener">
                            <span class="link-icon">{{ include('_tile-visual.html.twig', {tile: link.tile}, false) }}</span>
                            <span class="link-text">
                                <span class="link-title">
                                    {{ link.title }}
                                    {% if link.language|default('en') != 'en' %}
                                        <span class="lang-badge">{{ link.language|upper }}</span>
                                    {% endif %}
                                </span>
                                {% if link.description|default('') %}
                                    <span class="link-description">{{ link.description }}</span>
                                {% endif %}
                            </span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
</section>
