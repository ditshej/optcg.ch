<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <script>
        document.documentElement.classList.add('js');
        // The drawing-in animation runs on the first visit only; the marker is a localStorage flag, not a cookie.
        try { if (!localStorage.getItem('optcg-intro')) { document.documentElement.classList.add('intro'); localStorage.setItem('optcg-intro', '1'); } } catch (e) {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0b2a46">
    <title>optcg.ch — the Thousand Sunny, a chart of One Piece Card Game links</title>
    <meta name="description" content="Links about the One Piece Card Game, grouped by the rooms of the Thousand Sunny.">
    <link rel="icon" type="image/svg+xml" href="favicon.svg">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    {{ shipDefs|raw }}
    <div class="screen">
        <header class="top">
            <a class="logo" href="./" aria-label="optcg.ch, back to the chart">
                {{ logoSvg|raw }}
                <span class="logo-text">optcg.ch</span>
            </a>
            <p class="tagline">Helpful links around the card game</p>
        </header>
        <main class="stage" id="stage">
            <h1 class="visually-hidden">Rooms of the Thousand Sunny</h1>
            <div class="sheetwrap" id="sheetwrap">
                {{ include('ship-plan.html.twig') }}
                {{ include('ship-portrait.html.twig') }}
            </div>
        </main>
        <nav class="topics" aria-label="Topics">
            <ol>
                {% for r in roomViews %}
                    <li style="--i:{{ loop.index0 }}"><a href="#{{ r.room.id }}" data-room="{{ r.room.id }}" aria-label="{{ r.room.topic }}, {{ r.room.name }}, {{ r.linkCount == 1 ? '1 link' : r.linkCount ~ ' links' }}">
                        <span class="t-no">{{ r.number }}</span>
                        <span class="t-txt">{{ r.room.topic }}</span>
                    </a></li>
                {% endfor %}
            </ol>
        </nav>
        {{ include('footer.html.twig') }}
    </div>
    <div class="room-sections">
        {% for r in roomViews %}
            {{ include('room-section.html.twig', {r: r}, false) }}
        {% endfor %}
    </div>
    <dialog id="sheet" aria-labelledby="sheet-title" aria-describedby="sheet-kicker">
        <header class="sheet-head">
            <span class="grip" aria-hidden="true"></span>
            <div class="sheet-title">
                <p class="sheet-kicker" id="sheet-kicker"></p>
                <h2 id="sheet-title" tabindex="-1"></h2>
            </div>
            <button type="button" class="sheet-close" id="sheet-close">Close</button>
        </header>
        <div class="sheet-body" id="sheet-body"></div>
    </dialog>
    <script src="js/sunny.js" defer></script>
</body>
</html>
