{
    "name": "ditshej/optcg.ch",
    "description": "optcg.ch landing page: data loading, validation and CLI tools",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "justinrainbow/json-schema": "^6.2",
        "symfony/yaml": "^7.1",
        "twig/twig": "^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Optcg\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Optcg\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "scripts": {
        "validate-data": "php bin/validate-data.php",
        "fetch-icons": "php bin/fetch-icons.php",
        "test": "phpunit",
        "lint:twig": "twig-cs-fixer lint templates --no-cache",
        "fix:twig": "twig-cs-fixer fix templates --no-cache"
    }
}
